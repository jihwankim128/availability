      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "custom": {"axisLabel": "Circuit Breaker 상태", "drawStyle": "line", "fillOpacity": 30, "lineInterpolation": "stepAfter", "lineWidth": 3, "pointSize": 5, "showPoints": "always"}, "decimals": 0, "mappings": [{"options": {"0": {"text": "CLOSED"}, "1": {"text": "OPEN"}, "2": {"text": "HALF_OPEN"}}, "type": "value"}], "max": 2, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}, {"color": "orange", "value": 2}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single"}},
      "targets": [{"editorMode": "code", "expr": "sum without(state) (resilience4j_circuitbreaker_state{run_id=~\"$run_id\",name=\"externalApi\",state=\"open\"}) + 2 * sum without(state) (resilience4j_circuitbreaker_state{run_id=~\"$run_id\",name=\"externalApi\",state=\"half_open\"})", "legendFormat": "Circuit Breaker 상태", "range": true, "refId": "A"}],
