      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"axisLabel": "초당 완료 요청", "drawStyle": "line", "fillOpacity": 18, "lineWidth": 2, "pointSize": 4, "showPoints": "auto"}, "min": 0, "unit": "reqps"}, "overrides": []},
